{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "rootDir": "./src/ts",
    "outDir": "./dist/js",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "sourceMap": false,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src/ts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}